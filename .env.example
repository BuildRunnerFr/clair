# Public Supabase project configuration from Project Settings > API / Connect.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only development switch. Disable it in production after testing.
ENABLE_MOCK_IMPORT=true

# Server-only TrueLayer configuration. Never prefix with NEXT_PUBLIC_.
TRUELAYER_CLIENT_ID=sandbox-your-client-id
TRUELAYER_CLIENT_SECRET=your-sandbox-client-secret
TRUELAYER_REDIRECT_URI=http://localhost:3000/api/banking/truelayer/callback
TRUELAYER_ENV=sandbox

# Going live reads real bank accounts under a real consent, so TRUELAYER_ENV=live alone is
# refused. It additionally requires the acknowledgement below, an https redirect URI, and a
# real 32-byte encryption key. See docs/TRUELAYER_SANDBOX.md.
# TRUELAYER_ENV=live
# TRUELAYER_LIVE_CONFIRMED=i-understand-this-reads-real-bank-accounts
# Optional: restrict the bank picker. Leave unset in live so TrueLayer shows every supported
# bank, which is how a user selects Revolut. Sandbox defaults to the mock bank.
# TRUELAYER_PROVIDERS=uk-ob-revolut

# Server-only access to tables explicitly denied to browser roles.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 32 random bytes, base64-encoded: openssl rand -base64 32
BANK_TOKEN_ENCRYPTION_KEY=your-32-byte-base64-key

# Server-only AI categorization. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=your-openai-api-key
OPENAI_CATEGORIZATION_MODEL=gpt-5.6-luna

# Alerte d'exploitation. Sans ces variables, rien n'est envoyé et rien ne casse : la
# synchronisation se termine normalement, seul le journal en garde trace.
#
# La clé se crée sur resend.com (gratuit jusqu'à 3 000 envois par mois). Tant qu'un domaine n'y
# est pas vérifié, Resend n'accepte d'expédier que depuis onboarding@resend.dev et seulement vers
# l'adresse du compte : c'est suffisant pour une alerte qu'on s'envoie à soi-même. Une fois
# clairfinances.com vérifié, ALERT_EMAIL_FROM peut devenir alertes@clairfinances.com.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
