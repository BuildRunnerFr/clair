# Les deux seules variables dont l'application mobile a besoin.
#
# Publiques par construction : elles partent dans le paquet installé sur le téléphone, où rien
# ne reste secret. C'est la RLS qui protège les données, pas la discrétion de cette clé — la même
# hypothèse que sur le web.
#
# Aucune clé OpenAI ni TrueLayer ici : ces opérations passent par les routes HTTP du serveur,
# précisément pour que leurs secrets ne quittent jamais celui-ci.
EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=votre-cle-publiable
EXPO_PUBLIC_API_URL=https://clairfinances.com
